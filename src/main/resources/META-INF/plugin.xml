<idea-plugin require-restart="false">
    <id>com.github.toxdev.fish</id>
    <name>Fish Shell</name>
    <vendor url="https://plugins.jetbrains.com/vendor/jetbrains-fish-shell">JetBrains Fish Shell</vendor>

    <category>Languages</category>

    <change-notes><![CDATA[
    See <a href="https://github.com/tox-dev/jetbrains-fish/releases">GitHub Releases</a> for changelog.
    ]]></change-notes>

    <description><![CDATA[
    <p>Comprehensive language support for <a href="https://fishshell.com/">Fish shell</a> scripts with advanced IDE features.</p>

    <h3>Syntax Highlighting</h3>
    <ul>
        <li>Keywords, variables, strings, comments, operators</li>
        <li>Redirections and command substitution</li>
        <li>Customizable color schemes</li>
    </ul>

    <h3>Code Intelligence (via fish-lsp)</h3>
    <ul>
        <li>Code completion with context-aware suggestions</li>
        <li>Go to definition for functions and variables</li>
        <li>Find references across workspace</li>
        <li>Hover documentation</li>
        <li>Diagnostics and code actions</li>
        <li>Rename refactoring</li>
    </ul>

    <h3>Navigation & Structure</h3>
    <ul>
        <li>Structure view with function navigation</li>
        <li>Breadcrumbs navigation</li>
        <li>Code folding for functions and control structures</li>
        <li>Brace matching</li>
    </ul>

    <h3>Editing Support</h3>
    <ul>
        <li>Comment/uncomment with Ctrl+/</li>
        <li>Code formatting via fish-lsp</li>
        <li>Run configurations to execute scripts</li>
        <li>Run gutter icon for quick script execution</li>
    </ul>

    <h3>Setup</h3>
    <p><b>fish-lsp (Recommended):</b> For full code intelligence, install <a href="https://github.com/ndonfris/fish-lsp">fish-lsp</a>:</p>
    <pre>npm install -g fish-lsp</pre>
    <p>The plugin auto-detects fish-lsp in PATH, or configure it in <b>Settings → Tools → Fish Shell</b>.</p>
    <p><b>Community Edition:</b> Install the <a href="https://plugins.jetbrains.com/plugin/23257-lsp4ij">LSP4IJ plugin</a> for LSP support. Ultimate editions have built-in LSP support.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="fish-lsp-ultimate.xml">com.intellij.modules.ultimate</depends>
    <depends optional="true" config-file="fish-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Notification Group -->
        <notificationGroup id="Fish LSP"
                           displayType="BALLOON"/>

        <!-- Settings Page -->
        <applicationConfigurable
            parentId="tools"
            instance="com.github.toxdev.fish.lsp.FishLspConfigurable"
            id="com.github.toxdev.fish.lsp.FishLspConfigurable"
            displayName="Fish Shell"/>

        <!-- File Type -->
        <fileType
            name="Fish"
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishFileType"
            fieldName="INSTANCE"
            extensions="fish"
            hashBangs="fish"/>

        <!-- Parser -->
        <lang.parserDefinition
            language="Fish"
            implementationClass="com.github.toxdev.fish.parser.FishParserDefinition"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
            language="Fish"
            implementationClass="com.github.toxdev.fish.highlighting.FishSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage
            implementation="com.github.toxdev.fish.highlighting.FishColorSettingsPage"/>

        <!-- Commenter (Ctrl+/) -->
        <lang.commenter
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishCommenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishBraceMatcher"/>

        <!-- Code Folding -->
        <lang.foldingBuilder
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishFoldingBuilder"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory
            language="Fish"
            implementationClass="com.github.toxdev.fish.structure.FishStructureViewFactory"/>

        <!-- Breadcrumbs -->
        <breadcrumbsInfoProvider
            implementation="com.github.toxdev.fish.FishBreadcrumbsProvider"/>

        <!-- Run Configuration -->
        <configurationType
            implementation="com.github.toxdev.fish.run.FishRunConfigurationType"/>

        <!-- Run Line Marker -->
        <runLineMarkerContributor
            language="Fish"
            implementationClass="com.github.toxdev.fish.run.FishRunLineMarkerProvider"/>

        <!-- Live Templates -->
        <liveTemplateContext
            contextId="Fish"
            implementation="com.github.toxdev.fish.FishLiveTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/Fish.xml"/>

        <!-- Color Preview -->
        <codeInsight.lineMarkerProvider
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishColorPreviewProvider"/>
    </extensions>
</idea-plugin>
