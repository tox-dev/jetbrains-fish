<idea-plugin require-restart="false">
    <id>com.github.toxdev.fish</id>
    <name>Fish Shell</name>
    <vendor url="https://plugins.jetbrains.com/vendor/jetbrains-fish-shell">JetBrains Fish Shell</vendor>

    <category>Languages</category>

    <change-notes><![CDATA[
    See <a href="https://github.com/tox-dev/jetbrains-fish/releases">GitHub Releases</a> for changelog.
    ]]></change-notes>

    <description><![CDATA[
    <p>Comprehensive language support for <a href="https://fishshell.com/">Fish shell</a> scripts with advanced IDE features.</p>

    <h3>Syntax Highlighting</h3>
    <p>Rich highlighting for keywords, variables, strings, comments, operators, redirections, and command substitution with customizable color schemes.</p>

    <h3>Code Intelligence (via fish-lsp)</h3>
    <p>When <a href="https://github.com/ndonfris/fish-lsp">fish-lsp</a> is installed, the plugin provides:</p>
    <ul>
        <li>Context-aware code completion for functions, variables, and commands.</li>
        <li>Go to definition and find references across your workspace.</li>
        <li>Hover documentation and real-time diagnostics.</li>
        <li>Code actions, quick fixes, and rename refactoring.</li>
    </ul>

    <h3>Navigation & Structure</h3>
    <p>Structure view for function navigation, breadcrumbs, code folding for functions and control structures, and brace matching.</p>

    <h3>Editing Support</h3>
    <p>Comment toggling with Ctrl+/, code formatting via fish-lsp, run configurations, run gutter icons, live templates for common constructs, and color preview for <code>set_color</code> commands.</p>

    <h3>Code Quality</h3>
    <p>Inspections for deprecated Fish syntax and unused local variables.</p>

    <h3>File Recognition</h3>
    <p>Automatically recognizes <code>.fish</code> files and scripts with Fish shebang (<code>#!/usr/bin/env fish</code>).</p>

    <h3>Setup</h3>
    <p>For full code intelligence, <a href="https://github.com/ndonfris/fish-lsp#installation">install fish-lsp</a>. The plugin auto-detects fish-lsp in PATH, or configure it in <b>Settings → Tools → Fish Shell</b>.</p>
    <p>Community Edition users need the <a href="https://plugins.jetbrains.com/plugin/23257-lsp4ij">LSP4IJ plugin</a> for LSP support. Ultimate editions have built-in LSP support.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="fish-lsp-ultimate.xml">com.intellij.modules.ultimate</depends>
    <depends optional="true" config-file="fish-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Notification Group -->
        <notificationGroup id="Fish LSP"
                           displayType="BALLOON"/>

        <!-- Settings Page -->
        <applicationConfigurable
            parentId="tools"
            instance="com.github.toxdev.fish.lsp.FishLspConfigurable"
            id="com.github.toxdev.fish.lsp.FishLspConfigurable"
            displayName="Fish Shell"/>

        <!-- File Type -->
        <fileType
            name="Fish"
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishFileType"
            fieldName="INSTANCE"
            extensions="fish"
            hashBangs="fish"/>

        <!-- Parser -->
        <lang.parserDefinition
            language="Fish"
            implementationClass="com.github.toxdev.fish.parser.FishParserDefinition"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
            language="Fish"
            implementationClass="com.github.toxdev.fish.highlighting.FishSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage
            implementation="com.github.toxdev.fish.highlighting.FishColorSettingsPage"/>

        <!-- Commenter (Ctrl+/) -->
        <lang.commenter
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishCommenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishBraceMatcher"/>

        <!-- Code Folding -->
        <lang.foldingBuilder
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishFoldingBuilder"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory
            language="Fish"
            implementationClass="com.github.toxdev.fish.structure.FishStructureViewFactory"/>

        <!-- Breadcrumbs -->
        <breadcrumbsInfoProvider
            implementation="com.github.toxdev.fish.FishBreadcrumbsProvider"/>

        <!-- Run Configuration -->
        <configurationType
            implementation="com.github.toxdev.fish.run.FishRunConfigurationType"/>
        <runConfigurationProducer
            implementation="com.github.toxdev.fish.run.FishRunConfigurationProducer"/>
        <programRunner
            implementation="com.github.toxdev.fish.run.FishRunProgramRunner"/>

        <!-- Run Line Marker -->
        <runLineMarkerContributor
            language="Fish"
            implementationClass="com.github.toxdev.fish.run.FishRunLineMarkerProvider"/>

        <!-- Live Templates -->
        <liveTemplateContext
            contextId="Fish"
            implementation="com.github.toxdev.fish.FishLiveTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/Fish.xml"/>

        <!-- Color Preview -->
        <codeInsight.lineMarkerProvider
            language="Fish"
            implementationClass="com.github.toxdev.fish.FishColorPreviewProvider"/>
    </extensions>

    <actions>
        <action id="runFishFileAction"
                class="com.github.toxdev.fish.run.FishRunFileAction"
                text="Run Fish Script"
                description="Run the current Fish script"/>
    </actions>
</idea-plugin>
